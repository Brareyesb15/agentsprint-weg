# Copia este archivo como `.env` y llena los valores.
# `.env` esta en .gitignore: NUNCA se commitea.
#   PowerShell:  Copy-Item .env.example .env

# --- Las 4 keys de Gemini (una por persona del equipo, con rotacion) ---
# Se crean en https://aistudio.google.com/apikey
# Empiezan por "AIza...". Basta con la 1 para probar; las otras 3 se llenan manana.
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=

# --- Modelo ---
# REGLA DURA: el nombre del modelo va aqui, JAMAS escrito en el codigo.
# Cambiarlo debe ser una sola linea. Candidatos con tier gratis (verificar cual
# responde de verdad con la prueba real, no leyendo documentacion):
#   gemini-3.6-flash · gemini-3-flash-preview · gemini-3.5-flash
MODEL_NAME=gemini-3.6-flash

# Modelo barato para pasos de texto liviano (opcional, para no gastar cuota)
MODEL_NAME_LIGHT=gemini-3.5-flash-lite

# --- Respaldo de modelos: LO MAS IMPORTANTE DE ESTE ARCHIVO ---
# VERIFICADO el 24-jul-2026 con una key real, no leido en un blog:
# la cuota del tier gratis es POR PROYECTO Y POR MODELO.
#   gemini-3.6-flash        limit: 20 requests/DIA
#   gemini-3-flash-preview  cuota PROPIA (seguia disponible con la otra agotada)
#   gemini-2.0-flash        limit: 0 -> no esta en el tier gratis
#   gemini-2.5-flash        404 con esta key
# Un turno del agente gasta entre 3 y 6 llamadas => 20/dia son ~4 preguntas.
# Por eso el cliente rota keys Y modelos. Se prueban en este orden:
MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.5-flash

# --- Puertos y rutas ---
API_PORT=8000
UI_PORT=5173
DATA_DIR=./data

# --- Parametros del agente ---
# Lado mayor al que se reescala la foto antes de enviarla al modelo.
# Una foto de celular sin tocar consume muchisimos tokens.
IMAGE_MAX_SIDE=768

# Tolerancia relativa cuando el guard compara unidades equivalentes
# (ej: 3,7 kW vs 5 HP son el mismo motor pero no dan identico).
GUARD_TOLERANCIA=0.02
